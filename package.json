{
  "name": "mcbuddy-bot",
  "version": "1.2.1",
  "description": "🤖 Telegram-бот для общения с MCBuddy — спрашивай о Майнкрафте и мгновенно получай понятные, точные ответы! 📱",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/application/entrypoint.ts --outdir dist/application --target bun",
    "test": "bun test"
  },
  "keywords": [
    "minecraft",
    "ai",
    "assistant",
    "telegram",
    "bot",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/node-telegram-bot-api": "^0.64.13",
    "node-telegram-bot-api": "^0.66.0",
    "telegramify-markdown": "^1.3.0",
    "tslog": "^4.10.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
